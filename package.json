{
  "name": "proyecto-nexo",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:integration": "node scripts/test-postgres.mjs",
    "test:all": "npm test && npm run test:integration && npm run test:runner && npm run test:local-api",
    "test:runner": "node scripts/verify-test-exit.mjs",
    "test:local-api": "node scripts/verify-local-api.mjs",
    "dev:local": "node scripts/test-postgres.mjs --serve-http"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17"
  }
}
